{
  "name": "astro-ai-backend",
  "version": "1.0.0",
  "description": "Astro AI - API + web UI (mobile keeps using /api)",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "build:client": "npm run build"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "uuid": "^11.0.5"
  },
  "engines": {
    "node": ">=18"
  }
}
